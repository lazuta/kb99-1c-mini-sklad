
Процедура ПередЗаписью(Отказ)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(Телефон) Тогда
        Возврат;
    КонецЕсли;

    КодОператора = Сред(Телефон, 6, 2);

    Если КодОператора <> "29" И
         КодОператора <> "33" И
         КодОператора <> "44" Тогда

        Сообщить("Допустимые коды оператора: 29, 33, 44.");
        Отказ = Истина;

    КонецЕсли;

КонецПроцедуры
